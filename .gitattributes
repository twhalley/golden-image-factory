# Normalise to LF in the repository. Windows-consumed files are checked out CRLF
# so that Autounattend.xml and Pester scripts behave when handed to a Windows guest.
* text=auto eol=lf

*.xml   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Never text-munge these.
*.png   binary
*.iso   binary
*.qcow2 binary
*.vmdk  binary
