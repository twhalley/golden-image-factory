// Template only. Every value here is a dummy.
//
// Copy to secrets.pkrvars.hcl (gitignored) ONLY if you cannot use environment
// variables. The supported path is PKR_VAR_* in the environment, so that a real
// credential never exists as a file that can be committed by accident:
//
//   export PKR_VAR_vcenter_password='...'
//   export PKR_VAR_azure_subscription_id='...'
//
// In CI there is no file and no secret: Azure authenticates through a GitHub
// OIDC federated credential, and the vSphere path runs only against the local
// nested lab. See docs/RUNBOOK.md.

// --- vSphere (phase 9, nested evaluation lab) ------------------------------
vcenter_server     = "vcenter.lab.invalid"
vcenter_username   = "administrator@vsphere.local"
vcenter_password   = "REPLACE-ME-DO-NOT-COMMIT"
vcenter_insecure   = true
vsphere_datacenter = "Datacenter"
vsphere_cluster    = "Cluster"
vsphere_datastore  = "datastore1"
vsphere_folder     = "templates"
vsphere_network    = "VM Network"

// --- Azure (phase 8) --------------------------------------------------------
// No client secret appears here or anywhere else. OIDC only.
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
azure_client_id       = "00000000-0000-0000-0000-000000000000"
azure_location        = "uksouth"
azure_resource_group  = "rg-golden-image-factory"
azure_gallery_name    = "goldenimagefactory"
